# Standard
node_modules

# Build.One Workspace directories & files
/data
/tmp
/logs

# Additional ignores
/version.json
*.log
*.dfw
/.vscode/*.code-snippets
/.vscode/mcp.json

# Yarn
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Claude Code local settings
.claude/settings.local.json
.claude/mcp-configs/
.claude/commands/

# OpenHands generated microagents (contain auth tokens)
.openhands/microagents/mcp-tools.md

# Local environment overrides (Neon DB credentials, etc.)
.env.local

# Secrets pulled from the auth server by fetch-user-secrets.sh. Machine-written
# and rewritten on every start — unlike a hand-authored .env.secrets.
.env.fetched

# Local development secrets
.env.secrets

# AWS CodeArtifact token (generated by b1 aws-login)
.aws-token.env

# Workspace env files (.env.local, .env.fetched, .aws-token.env). Machine-written
# or developer-local, and never committed — see .b1/env/.
/.b1/env/

# Demo factory local cache
/src/demo-factory/.cache

# The Laminar skill is not ours: `npx lmnr-cli setup` downloads it from Laminar's
# skills repository (main branch) and rewrites a copy in every agent folder present.
.claude/skills/laminar/
.agents/skills/laminar/
.codex/skills/laminar/

# Generated by `b1 gencom` from the stack objects; nothing in it is committed (B1-1523).
/.deploy/
