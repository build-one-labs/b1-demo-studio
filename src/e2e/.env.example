# E2E test environment configuration.
# Copy to `.env` (gitignored) or export these in your shell.
#
# In the dev container none of this is normally needed: `.bashrc` sources the
# workspace environment, which already carries AUTH_URL and the API key.

# Base URL of the running app (Caddy). Defaults to http://localhost:8080.
# E2E_BASE_URL=http://localhost:8080

# THE DEDICATED TEST USER'S KEY. This is the one to set, and normally it is set
# centrally as an organization secret rather than here, so every workspace and
# every CI run picks it up.
#
# Why not your own key: a spec that asserts against data owned by a user and
# visible only to its owner (drafts, private saved filters) passes or fails
# according to whose key is in the environment. Pinning the identity is what
# makes the result mean something.
# B1_E2E_API_KEY=b1k_...
#
# A key is a row in one auth server's database and 401s at every other, so it
# can be held per server, with the host uppercased and its dots and dashes as
# underscores. The unqualified name is right for a single-environment workspace.
# B1_E2E_API_KEY__AUTH_DEVELOP_TEST_BUILD_ONE=b1k_...
#
# Fallback if no B1_E2E_API_KEY is set: your personal key, with a warning.
#   b1 api-key check     # verify the resolved key against AUTH_URL
#   b1 api-key set <key> # store one
# AUTH_URL=https://auth.example.build.one
# B1_USER_API_KEY=b1k_...

# Fallback: the system-user form login. Only useful where the auth server
# actually knows this password — a workspace running its own (local) auth
# server, or an environment you hold real credentials for. Against a shared
# auth server the generated password matches no user.
# B1_SYSTEM_USER_EMAIL=system@build.one
# B1_SYSTEM_USER_PASSWORD=

# Recording screencasts costs the renderer real memory; opt out on a
# constrained machine.
# E2E_VIDEO=off
