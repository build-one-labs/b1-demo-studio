{
  "name": "app-server-ts",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --max-warnings=0 && eslint --config demo-factory/eslint.config.mjs demo-factory --max-warnings=0",
    "lint:fix": "eslint . --fix && eslint --config demo-factory/eslint.config.mjs demo-factory --fix",
    "test": "jest --passWithNoTests && node --test demo-factory/tests/*.test.mjs",
    "test:demo-factory": "node --test demo-factory/tests/*.test.mjs",
    "demo:provision": "node demo-factory/tools/provision-workspace.mjs",
    "demo:validate": "node demo-factory/src/cli.mjs validate",
    "demo:prepare": "node demo-factory/src/cli.mjs prepare",
    "demo:record": "node demo-factory/src/cli.mjs record",
    "demo:render": "node demo-factory/src/cli.mjs render",
    "demo": "node demo-factory/tools/run-demo.mjs",
    "demo:auth:b1": "node demo-factory/tools/capture-auth.mjs",
    "demo:auth:workspace": "node demo-factory/tools/b1-auth-state.mjs",
    "demo:publish:web": "node demo-factory/tools/publish-web.mjs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate:generate": "drizzle-kit --config src/drizzle/drizzle.config.ts generate --name ",
    "db:migrate": "APP_DATABASE_URL=$(echo \"${APP_DATABASE_URL}\" | sed 's/app_db_server:5432/127.0.0.1:15432/') drizzle-kit --config src/drizzle/drizzle.config.ts migrate",
    "database:seed": "APP_DATABASE_URL=$(echo \"${APP_DATABASE_URL}\" | sed 's/app_db_server:5432/127.0.0.1:15432/') node dist/seed.js"
  },
  "dependencies": {
    "@buildone/app-server-tslib": "24.3.0-VG.410",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.18",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/terminus": "^11.1.1",
    "@playwright/test": "^1.62.1",
    "@remotion/bundler": "4.0.507",
    "@remotion/renderer": "4.0.507",
    "axios": "^1.11.0",
    "change-case": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "memory-cache": "^0.2.0",
    "nestjs-cls": "^6.0.1",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "pg": "^8.16.3",
    "qs": "^6.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "remotion": "4.0.507",
    "rxjs": "^7.8.1",
    "yaml": "^2.8.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/memory-cache": "^0",
    "@types/node": "^22.0.0",
    "@types/passport": "^0",
    "@types/passport-http-bearer": "^1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.11.0",
    "jest": "^29.5.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-morph": "^25.0.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
