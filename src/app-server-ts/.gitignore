# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Demo Factory (demo-factory/): recorded clips, narration, rendered videos and
# their caches — large, and reproducible from demo.yaml.
/demo-factory/output
/demo-factory/public/generated
/demo-factory/.cache
/demo-factory/test-results
/demo-factory/.qa*
# A live browser session (auth:b1 / auth-from-session) — never committed.
/demo-factory/playwright/.auth
# One workspace's view of the pipeline, written by demo-factory/tools/provision-workspace.mjs.
/demo-factory/.env
/demo-factory/.env.app-server
# The standalone renderer's own install (remote machines only; the workspace
# resolves the pipeline's dependencies from the app server's node_modules).
/demo-factory/node_modules
/demo-factory/package-lock.json
